# Numéro(s) autorisé(s) en tant que owner (indicatif pays, sans + ni espace)
# Plusieurs numéros séparés par une virgule : "33612345678,50933715832"
OWNER_NUMBER=

# Identifie le dossier de session — mets le numéro du bot une fois connecté
SESSION_NUMBER=

# Chaîne générée par .getsession — colle-la ici pour restaurer la session
# automatiquement après un redémarrage sur Render, sans avoir à rescanner
SESSION_ID=

# IA (commande .ai) — compatible avec toute API type "OpenAI chat completions"
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Port local (Render fournit automatiquement le sien)
PORT=3000
